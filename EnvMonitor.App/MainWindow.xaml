<Window x:Class="EnvMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Environment Monitor"
        Height="640"
        Width="1060"
        MinHeight="560"
        MinWidth="900"
        Background="#F4F7FB"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172033" />
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,28">
            <StackPanel>
                <TextBlock Text="ENVIRONMENT MONITOR"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#3478F6" />
                <TextBlock Text="Device overview"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#172033"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#94A3B8" Margin="0,0,8,0" />
                <TextBlock x:Name="StatusText" Text="Disconnected" FontSize="15" Foreground="#64748B" VerticalAlignment="Center" />
                <Button x:Name="ConnectButton"
                        Content="Connect demo"
                        Click="ConnectButton_Click"
                        Margin="22,0,0,0"
                        Padding="18,10"
                        Background="#3478F6"
                        Foreground="White"
                        BorderThickness="0" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="TEMPERATURE" Foreground="#64748B" FontWeight="SemiBold" />
                    <TextBlock x:Name="TemperatureText" Text="25.0 °C" Style="{StaticResource MetricValue}" Margin="0,12,0,0" />
                    <TextBlock Text="Normal range" Foreground="#16A36A" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="HUMIDITY" Foreground="#64748B" FontWeight="SemiBold" />
                    <TextBlock x:Name="HumidityText" Text="48.0 %" Style="{StaticResource MetricValue}" Margin="0,12,0,0" />
                    <TextBlock Text="Stable" Foreground="#16A36A" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="PRESSURE" Foreground="#64748B" FontWeight="SemiBold" />
                    <TextBlock x:Name="PressureText" Text="101.3 kPa" Style="{StaticResource MetricValue}" Margin="0,12,0,0" />
                    <TextBlock Text="Stable" Foreground="#16A36A" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#172033" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="RELAY 1" Foreground="#AAB7CC" FontWeight="SemiBold" />
                    <TextBlock x:Name="RelayText" Text="OFF" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,12,0,12" />
                    <Button x:Name="RelayButton" Content="Turn on" Click="RelayButton_Click" Padding="12,8" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Temperature trend" FontSize="19" FontWeight="SemiBold" Foreground="#172033" />
                    <TextBlock Text="Live chart will appear here once the simulator is connected." Foreground="#64748B" Margin="0,8,0,0" />
                    <Border Height="1" Background="#E2E8F0" Margin="0,24,0,0" />
                    <TextBlock Text="Waiting for device data" HorizontalAlignment="Center" Foreground="#94A3B8" Margin="0,90,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="Event log" FontSize="19" FontWeight="SemiBold" Foreground="#172033" />
                    <TextBlock x:Name="EventText" Text="Application ready." Foreground="#64748B" TextWrapping="Wrap" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
