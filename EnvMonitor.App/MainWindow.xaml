<Window x:Class="EnvMonitor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        Title="Environment Monitor"
        Height="640"
        Width="1060"
        MinHeight="560"
        MinWidth="900"
        Background="#F4F7FB"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <Style x:Key="MetricCard" TargetType="Border">
            <Setter Property="Background" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="Margin" Value="0,0,14,0" />
        </Style>
        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#172033" />
        </Style>
        <Style x:Key="TemperatureValue" BasedOn="{StaticResource MetricValue}" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsTemperatureAlarm}" Value="True">
                    <Setter Property="Foreground" Value="#C53030" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="HumidityValue" BasedOn="{StaticResource MetricValue}" TargetType="TextBlock">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHumidityAlarm}" Value="True">
                    <Setter Property="Foreground" Value="#C53030" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#64748B" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Connected">
                    <Setter Property="Foreground" Value="#16A36A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Alarm">
                    <Setter Property="Foreground" Value="#C53030" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Read timeout">
                    <Setter Property="Foreground" Value="#B7791F" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StatusDotStyle" TargetType="Ellipse">
            <Setter Property="Fill" Value="#94A3B8" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Connected">
                    <Setter Property="Fill" Value="#16A36A" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Alarm">
                    <Setter Property="Fill" Value="#C53030" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Read timeout">
                    <Setter Property="Fill" Value="#B7791F" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <TabControl Margin="20">
        <TabItem Header="Environment monitor">
            <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,28">
            <StackPanel>
                <TextBlock Text="ENVIRONMENT MONITOR"
                           FontSize="13"
                           FontWeight="SemiBold"
                           Foreground="#3478F6" />
                <TextBlock Text="Device overview"
                           FontSize="32"
                           FontWeight="Bold"
                           Foreground="#172033"
                           Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Style="{StaticResource StatusDotStyle}" Margin="0,0,8,0" />
                <TextBlock Text="{Binding Status}" FontSize="15" Style="{StaticResource StatusTextStyle}" VerticalAlignment="Center" />
                <Button Content="{Binding ConnectButtonText}"
                    Command="{Binding ConnectCommand}"
                        Margin="22,0,0,0"
                        Padding="18,10"
                        Background="#3478F6"
                        Foreground="White"
                        BorderThickness="0" />
                    <Button Content="Reconnect"
                        Command="{Binding ReconnectCommand}"
                        Margin="10,0,0,0"
                        Padding="14,10" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="220" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="TEMPERATURE" Foreground="#64748B" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Temperature, StringFormat={}{0:F1} °C}" Style="{StaticResource TemperatureValue}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding TemperatureState}" Foreground="#16A36A" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="HUMIDITY" Foreground="#64748B" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Humidity, StringFormat={}{0:F1} %}" Style="{StaticResource HumidityValue}" Margin="0,12,0,0" />
                    <TextBlock Text="{Binding HumidityState}" Foreground="#16A36A" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource MetricCard}">
                <StackPanel>
                    <TextBlock Text="PRESSURE" Foreground="#64748B" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Pressure, StringFormat={}{0:F1} kPa}" Style="{StaticResource MetricValue}" Margin="0,12,0,0" />
                    <TextBlock Text="Stable" Foreground="#16A36A" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="#172033" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock Text="RELAY 1" Foreground="#AAB7CC" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Relay1, StringFormat={}{0:ON;OFF}}" FontSize="28" FontWeight="Bold" Foreground="White" Margin="0,12,0,12" />
                    <ToggleButton Content="Toggle relay"
                                  IsChecked="{Binding Relay1, Mode=TwoWay}"
                                  Command="{Binding ToggleRelayCommand}"
                                  Padding="12,8" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="12" Padding="24" Margin="0,0,14,0">
                <StackPanel>
                    <TextBlock Text="Temperature trend" FontSize="19" FontWeight="SemiBold" Foreground="#172033" />
                    <TextBlock Text="Recent two minutes" Foreground="#64748B" Margin="0,8,0,0" />
                    <lvc:CartesianChart Series="{Binding TemperatureSeries}"
                                         Height="220"
                                         Margin="0,16,0,0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="24">
                <StackPanel>
                    <TextBlock Text="Event log" FontSize="19" FontWeight="SemiBold" Foreground="#172033" />
                    <TextBlock Text="{Binding EventMessage}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,18,0,0" />
                </StackPanel>
            </Border>
        </Grid>
            </Grid>
        </TabItem>
        <TabItem Header="STM32 LED">
            <Grid DataContext="{Binding LedViewModel, RelativeSource={RelativeSource AncestorType=Window}}" Margin="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="STM32F103C8T6" FontSize="30" FontWeight="Bold" Foreground="#172033" />
                    <TextBlock Text="USB CDC serial control for the PC13 onboard LED"
                               Foreground="#64748B"
                               Margin="0,6,0,0" />
                </StackPanel>

                <Border Grid.Row="1" Background="White" CornerRadius="12" Padding="22" Margin="0,24,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="COM PORT" Foreground="#64748B" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding AvailablePorts}"
                                      SelectedItem="{Binding SelectedPort, Mode=TwoWay}"
                                      Margin="0,8,12,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="BAUD RATE" Foreground="#64748B" FontWeight="SemiBold" />
                            <ComboBox SelectedValue="{Binding BaudRate, Mode=TwoWay}"
                                      SelectedValuePath="Tag"
                                      Margin="0,8,12,0">
                                <ComboBoxItem Content="115200" Tag="115200" />
                                <ComboBoxItem Content="57600" Tag="57600" />
                                <ComboBoxItem Content="9600" Tag="9600" />
                            </ComboBox>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Content="Refresh ports"
                                Command="{Binding RefreshPortsCommand}"
                                VerticalAlignment="Bottom"
                                Margin="0,0,12,0"
                                Padding="12,8" />
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Status}" FontSize="18" FontWeight="SemiBold" Foreground="#172033" />
                            <TextBlock Text="{Binding EventMessage}" Foreground="#64748B" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="4"
                                Content="{Binding ConnectButtonText}"
                                Command="{Binding ConnectCommand}"
                                VerticalAlignment="Center"
                                Padding="16,10"
                                Background="#3478F6"
                                Foreground="White"
                                BorderThickness="0" />
                    </Grid>
                </Border>

                <Border Grid.Row="2" Background="#172033" CornerRadius="12" Padding="32" MaxWidth="520" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel>
                        <TextBlock Text="BOARD LED" Foreground="#AAB7CC" FontWeight="SemiBold" />
                        <TextBlock Text="PC13" Foreground="White" FontSize="18" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding LedOn, StringFormat={}{0:ON;OFF}}" Foreground="White" FontSize="48" FontWeight="Bold" Margin="0,12,0,18" />
                        <ToggleButton Content="Toggle PC13 LED"
                                      IsChecked="{Binding LedOn, Mode=TwoWay}"
                                      Command="{Binding ToggleLedCommand}"
                                      IsEnabled="{Binding IsConnected}"
                                      Padding="16,10" />
                        <TextBlock Text="Common STM32F103C8T6 boards use active-low PC13 LED logic."
                                   Foreground="#AAB7CC"
                                   TextWrapping="Wrap"
                                   Margin="0,18,0,0" />
                    </StackPanel>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</Window>
